@using Microsoft.AspNetCore.Identity;
@using Microsoft.AspNetCore.Mvc.Localization
@inject SignInManager<Users> signInManager;
@inject IViewLocalizer Localizer

<ul class="navbar-nav ms-auto">
	@if (signInManager.IsSignedIn(User))
	{
		<li class="nav-item">
			<form method="post" asp-controller="Account" asp-action="Logout" class="form-inline">
				<button type="submit" class="nav-link btn btn-link text-white">Logout</button>
			</form>
		</li>
	}
	else
	{
		<li class="nav-item">
			<a class="nav-link text-white" asp-controller="Account" asp-action="Login">@Localizer["Btn_Login"]</a>
		</li>
		<li class="nav-item">
			<a class="nav-link text-white" asp-controller="Account" asp-action="Register">@Localizer["Btn_Register"]</a>
		</li>
	}
</ul>