@model IEnumerable<MyWeb.Models.Book>

@{
    ViewData["Title"] = "Kết quả tìm kiếm";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}

<div class="container-fluid px-4 px-md-5 py-5 min-vh-100">

    <div class="mb-5 border-bottom border-dark pb-3">
        <h1 class="nike-font text-dark m-0" style="font-size: clamp(2.5rem, 5vw, 4rem); letter-spacing: -1px; line-height: 1;">
            KẾT QUẢ CHO: <span class="text-secondary">"@ViewBag.SearchQuery"</span>
        </h1>
        <p class="fw-bold mt-2 text-muted">@Model.Count() KẾT QUẢ TÌM THẤY</p>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-4">
            @foreach (var book in Model)
            {
                <div class="col fade-in-up">
                    <a href="@Url.Action("Details", "Home", new { id = book.Id })" class="text-decoration-none d-block group h-100 d-flex flex-column">
                        <div class="cover-wrapper bg-light position-relative overflow-hidden mb-3" style="aspect-ratio: 2/3;">
                            <img src="@(string.IsNullOrEmpty(book.CoverImageUrl) ? "https://via.placeholder.com/300x450" : book.CoverImageUrl)"
                                 class="w-100 h-100 object-fit-cover nike-img" alt="@book.Title">
                        </div>
                        <div class="nike-info d-flex flex-column flex-grow-1">
                            <h3 class="fw-bold text-dark mb-1 line-clamp-2" style="font-size: 1.1rem;">@book.Title</h3>
                            <div class="text-secondary mb-2" style="font-size: 0.95rem;">@(book.Category?.Name ?? "Manga")</div>
                            <div class="fw-bold text-dark mt-auto" style="font-size: 1rem;">@(book.Chapters?.Count ?? 0) CHƯƠNG</div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 my-5">
            <h2 class="nike-font text-muted mb-3" style="font-size: 3rem;">KHÔNG TÌM THẤY TRUYỆN</h2>
            <a href="/" class="btn btn-dark rounded-pill px-5 py-3 fw-bold text-uppercase mt-3">Quay lại trang chủ</a>
        </div>
    }
</div>

<style>
    .cover-wrapper {
        background-color: #f5f5f5;
    }

    .nike-img {
        transition: opacity 0.3s ease;
    }

    .group:hover .nike-img {
        opacity: 0.8;
    }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .fade-in-up {
        animation: fadeInUp 0.6s ease forwards;
        opacity: 0;
        transform: translateY(15px);
    }

    @@keyframes fadeInUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>